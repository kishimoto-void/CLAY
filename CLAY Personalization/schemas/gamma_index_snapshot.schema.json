{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gamma Index Metadata Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries", "holds"],
  "properties": {
    "entries": {
      "type": "array", "maxItems": 10000,
      "items": {"$ref": "#/$defs/entry"}
    },
    "holds": {
      "type": "array", "maxItems": 50000,
      "items": {"$ref": "#/$defs/hold"}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "resource_id", "version", "resource_kind", "scope", "content_digest", "source_ref", "source_status", "status", "claims", "tags", "created_at"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/id"},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "resource_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "scope": {"type": "string", "minLength": 1, "maxLength": 128},
        "content_digest": {"$ref": "#/$defs/digest"},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 2048},
        "source_status": {"enum": ["VERIFIED", "UNVERIFIED", "FAILED"]},
        "status": {"enum": ["CANDIDATE", "AVAILABLE", "HELD", "RESOLVED", "REJECTED", "SUPERSEDED"]},
        "claims": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "tags": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
        "created_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "hold": {
      "type": "object", "additionalProperties": false,
      "required": ["hold_id", "entry_id", "reason", "open_questions", "preserved_refs", "opened_at", "revisit_trigger", "status", "resolution", "resolution_evidence_ref", "closed_at"],
      "properties": {
        "hold_id": {"$ref": "#/$defs/id"},
        "entry_id": {"$ref": "#/$defs/id"},
        "reason": {"enum": ["INSUFFICIENT_EVIDENCE", "CONFLICTING_CANDIDATES", "SOURCE_UNVERIFIED", "MISSING_CONTEXT", "MISSING_CAPABILITY", "APPROVAL_PENDING", "POLICY_REVIEW", "VERSION_COLLISION", "OTHER"]},
        "open_questions": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
        "preserved_refs": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
        "opened_at": {"type": ["string", "null"], "format": "date-time"},
        "revisit_trigger": {"type": ["string", "null"], "maxLength": 2000},
        "status": {"enum": ["OPEN", "CLOSED"]},
        "resolution": {"type": ["string", "null"], "maxLength": 2000},
        "resolution_evidence_ref": {"type": ["string", "null"], "maxLength": 2048},
        "closed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
