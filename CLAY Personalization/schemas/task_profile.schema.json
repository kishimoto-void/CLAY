{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://top-mold.invalid/schemas/task_profile.schema.json",
  "title": "Top Mold Task-Domain Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "profile_version",
    "profile_kind",
    "display_name",
    "purpose",
    "scope",
    "compatibility",
    "overlay"
  ],
  "properties": {
    "schema_version": {"const": "top-mold/task-profile/1.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "profile_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "profile_kind": {"const": "task_domain"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_modes", "session_only", "contains_personal_data"],
      "properties": {
        "task_modes": {
          "type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["work", "verify", "design", "research", "chat"]}
        },
        "session_only": {"const": true},
        "contains_personal_data": {"const": false},
        "excluded_uses": {
          "type": "array", "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_mold_min_version", "top_mold_max_version"],
      "properties": {
        "top_mold_min_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "top_mold_max_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
      }
    },
    "required_capabilities": {
      "type": "array", "maxItems": 30, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$"}
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dial_overrides", "workflow_steps", "verification_requirements", "additive_constraints"],
      "properties": {
        "task_mode": {"enum": ["work", "verify", "design", "research", "chat"]},
        "dial_overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "proactiveness": {"type": "integer", "minimum": 0, "maximum": 100},
            "initiative": {"type": "integer", "minimum": 0, "maximum": 100},
            "cross_domain_transfer": {"type": "integer", "minimum": 0, "maximum": 100},
            "generalization": {"type": "integer", "minimum": 0, "maximum": 100},
            "verification_strictness": {"type": "integer", "minimum": 0, "maximum": 100},
            "drift_allowance": {"type": "integer", "minimum": 0, "maximum": 100},
            "detail_structure": {"type": "integer", "minimum": 0, "maximum": 100},
            "concision": {"type": "integer", "minimum": 0, "maximum": 100},
            "human_control": {"type": "integer", "minimum": 0, "maximum": 100},
            "speculation_tolerance": {"type": "integer", "minimum": 0, "maximum": 100},
            "uncertainty_preservation": {"type": "integer", "minimum": 0, "maximum": 100},
            "contradiction_preservation": {"type": "integer", "minimum": 0, "maximum": 100},
            "transformation_fidelity": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        },
        "output_contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": {"enum": ["markdown", "json", "table", "code", "document", "other"]},
            "sections": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
            "citations_required": {"type": "boolean"},
            "tests_required_when_code_changes": {"type": "boolean"}
          }
        },
        "workflow_steps": {
          "type": "array", "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["step_id", "objective"],
            "properties": {
              "step_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$"},
              "objective": {"type": "string", "minLength": 1, "maxLength": 500},
              "required_inputs": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
              "expected_outputs": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
            }
          }
        },
        "verification_requirements": {
          "type": "array", "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additive_constraints": {
          "type": "array", "maxItems": 30,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  }
}
