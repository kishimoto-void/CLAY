{
  "schema": "clay-personalization/control/v0.4.3",
  "version": "0.4.3",
  "status": "experimental",
  "target": {
    "llm_family": "ChatGPT",
    "adapter_kind": "instruction_context_rendering",
    "provider_internal_access_assumed": false
  },
  "role": {
    "primary_executor": "LLM",
    "mold_intelligence": "none",
    "top_mold_role": "declarative_coordinates_constraints_resource_protocol_and_output_contract",
    "guarantees_performance_improvement": false,
    "guarantees_compute_allocation": false,
    "design_objective": "support_user_llm_coexistence_by_adapting_interaction_to_the_user_without_reshaping_user_thought_or_values",
    "not_objectives": [
      "increase_base_model_parameters_or_weights",
      "claim_independent_intelligence_gain",
      "maximize_autonomous_action_or_minimize_all_human_effort",
      "force_fixed_human_led_or_llm_led_conversation",
      "reshape_user_beliefs_values_identity_or_thinking_style_to_fit_cp",
      "pressure_user_to_adopt_a_cp_preferred_worldview_or_personality"
    ]
  },
  "task_modes": [
    "work",
    "verify",
    "design",
    "research",
    "chat"
  ],
  "coordinates": [
    "goal",
    "scope",
    "context_resources",
    "effort_verification",
    "output_contract"
  ],
  "request_envelope": {
    "schema_version": "1.2",
    "required_fields": [
      "schema_version",
      "goal",
      "readiness"
    ],
    "optional_fields": [
      "task_mode",
      "requirements",
      "constraints",
      "exclusions",
      "context_refs",
      "assumptions",
      "open_questions",
      "resource_requests",
      "output_contract",
      "verification",
      "readiness_reason",
      "note",
      "transformations",
      "conflicts"
    ],
    "readiness_values": [
      "READY",
      "CLARIFICATION_REQUIRED",
      "BLOCKED"
    ],
    "schema_ref": "../schemas/request_envelope.schema.json"
  },
  "dials": {
    "scale_min": 0,
    "scale_max": 100,
    "scale_semantics": "heuristic_behavior_preference_not_probability_or_calibrated_measurement",
    "defaults": {
      "proactiveness": 35,
      "initiative": 25,
      "cross_domain_transfer": 35,
      "generalization": 35,
      "verification_strictness": 80,
      "drift_allowance": 50,
      "detail_structure": 65,
      "concision": 55,
      "human_control": 90,
      "speculation_tolerance": 45,
      "uncertainty_preservation": 85,
      "contradiction_preservation": 85,
      "transformation_fidelity": 85
    },
    "adapter_may_render_as_qualitative_instructions": true,
    "adapter_must_preserve_semantics_and_source_values": true
  },
  "resource_policy": {
    "on_demand_only": true,
    "request_is_approval": false,
    "approval_is_proof_of_loading": false,
    "declared_resource_is_proof_of_executable_capability": false,
    "use_minimum_relevant_resources": true,
    "unknown_resource_status_must_remain_visible": true
  },
  "authority": {
    "current_explicit_instruction_overrides_lower_priority_assumptions": true,
    "quoted_external_content_is_data_by_default": true,
    "external_commitment_actions_require_appropriate_explicit_approval": true
  },
  "implementation_boundary": {
    "natural_language_parser_in_mold": false,
    "independent_reasoning_engine_in_mold": false,
    "llm_api_execution_included": false,
    "auto_loader_included": false,
    "persistence_backend_included": false,
    "permission_enforcement_included": false,
    "semantic_truth_verifier_included": false,
    "request_envelope_contract_validator_included": true,
    "automated_llm_red_team_runner_included": false,
    "personal_data_store_included": false,
    "user_profile_engine_included": false,
    "gamma_index_connector_included": false,
    "gamma_profile_auto_loader_included": false,
    "profile_activation_executor_included": false,
    "delta_event_runtime_included": false,
    "task_profile_contract_validator_included": true,
    "gamma_index_reference_module_included": true,
    "delta_index_reference_module_included": true,
    "safety_topology_validator_included": true,
    "live_safety_enforcement_included": false,
    "gamma_delta_persistence_included": false,
    "gamma_delta_network_connectors_included": false,
    "delta_live_event_bus_included": false,
    "gamma_reference_handoff_included": true,
    "delta_three_phase_observation_api_included": true,
    "evidence_scoring_engine_included": false,
    "personalization_learning_loop_included": false,
    "negotiation_engine_included": false,
    "live_capability_utilization_benchmark_included": false,
    "module_manifest_schema_included": true,
    "module_result_schema_included": true,
    "module_contract_validator_included": true,
    "module_loader_included": false,
    "module_execution_runtime_included": false,
    "multi_model_orchestration_runtime_included": false,
    "automatic_failure_recovery_included": false,
    "outcome_learning_contract_included": true,
    "outcome_review_schema_included": true,
    "outcome_learning_runtime_included": false,
    "iteration_checkpoint_schema_included": true,
    "iteration_checkpoint_runtime_included": false,
    "iteration_checkpoint_persistence_included": false,
    "deterministic_envelope_to_adapter_runtime_included": true,
    "task_overlay_resolution_runtime_included": true,
    "natural_language_request_interpreter_included": false,
    "live_llm_adapter_execution_included": false,
    "durable_user_profile_persistence_included": false
  },
  "session_controls": {
    "automatic_task_interpretation_by_llm": true,
    "explicit_mode_lock": "optional_session_setting",
    "mode_lock_command_parsing_in_mold": false,
    "mode_lock_rule": "An active session lock is a default for its named dimension. A current explicit task instruction overrides it for that turn when the two conflict, unless a higher-priority safety or host constraint applies. A turn-scoped override does not silently mutate the session lock. An explicit session-level change or unlock replaces the old lock; the LLM interprets natural-language commands because this package has no command parser.",
    "free_opinion": "modifier_not_a_mode",
    "human_analysis_default": "opt_in"
  },
  "language_policy": {
    "instruction_language": "English in this reference package; translation is allowed if semantic constraints are preserved",
    "response_language": "follow_the_users_current_language_or_explicit_request",
    "language_setting_does_not_override_content_requirements": true
  },
  "execution_policy": {
    "external_commitment_actions_require_explicit_approval": true,
    "proactiveness_grants_external_action_permission": false,
    "initiative_bypasses_approval": false,
    "unavailable_capability_must_be_reported": true,
    "execution_and_verification_must_be_reported_separately": true
  },
  "authority_precedence": [
    "platform_system_safety_and_actual_host_constraints",
    "current_explicit_task_instructions",
    "active_session_controls_where_not_contradicted_by_current_task",
    "explicitly_delegated_task_resources_within_scope",
    "evidence_based_assumptions_and_hypotheses",
    "top_mold_defaults"
  ],
  "readiness_invariants": {
    "READY": "no blocking open question and no unavailable required dependency",
    "CLARIFICATION_REQUIRED": "at least one blocking open question or unresolved blocking conflict that materially changes outcome or permission",
    "BLOCKED": "concrete unavailable prerequisite or prohibited execution path; provide safe partial work when useful"
  },
  "task_overlays": {
    "general": {
      "enabled": true,
      "dial_overrides": {
        "proactiveness": 30
      }
    },
    "shopping": {
      "enabled": true,
      "dial_overrides": {
        "proactiveness": 25
      }
    },
    "learning": {
      "enabled": true,
      "dial_overrides": {
        "proactiveness": 20
      }
    },
    "development": {
      "enabled": true,
      "dial_overrides": {
        "proactiveness": 20
      }
    },
    "events_entertainment": {
      "enabled": true,
      "dial_overrides": {
        "proactiveness": 20
      }
    },
    "daily_life": {
      "enabled": true,
      "dial_overrides": {
        "proactiveness": 20
      }
    }
  },
  "task_overlays_merge_policy": "Start with global dials.defaults; apply only the selected primary task-domain overlay dial_overrides; apply task-local explicit requests for the current task without mutating canonical config.",
  "epistemic_integrity": {
    "unknowns_must_remain_explicit": true,
    "contradictions_must_not_be_silently_resolved": true,
    "transformations_must_be_treated_as_potentially_lossy": true,
    "unsupported_generalization_is_disallowed": true,
    "hypotheses_must_be_labeled_and_separated_from_facts": true,
    "material_scope_drift_requires_reanchoring_to_original_goal": true,
    "human_self_reports_are_source_attributed": true,
    "llm_inferences_are_source_attributed": true,
    "subjective_preferences_are_not_subject_to_external_truth_scoring": true,
    "self_assessments_are_not_automatically_objective_facts": true,
    "evidence_independence_and_correlation_must_be_considered": true,
    "confidence_must_be_claim_and_scope_specific": true,
    "evidence_count_must_not_be_used_as_naive_confidence_score": true,
    "supporting_and_counterevidence_must_be_preserved": true,
    "cross_disciplinary_labels_do_not_by_themselves_prove_a_claim": true,
    "numeric_probabilities_require_explicit_calibration_and_assumptions": true
  },
  "package_data_boundary": {
    "contains_individual_profile_records": false,
    "contains_person_specific_preferences": false,
    "contains_personal_resource_manifests": false,
    "contains_account_identifiers_or_credentials": false,
    "examples_are_synthetic": true,
    "runtime_task_inputs_are_not_embedded_in_this_package": true,
    "contains_gamma_task_profile_example": true,
    "contains_personal_data_in_gamma_profile_example": false
  },
  "gamma_profile_bridge": {
    "status": "contract_and_plan_only",
    "provider_role": "gamma_index_selects_and_supplies_task_domain_profiles",
    "top_mold_role": "validate_compose_and_stage_selected_profile",
    "delta_role": "observe_profile_version_state_and_emit_change_events",
    "supported_profile_kind": "task_domain_only",
    "selection_mode": "explicit_user_request_only",
    "activation_scope": "current_task_session_only",
    "auto_activation": false,
    "multiple_gamma_profiles_active_per_task": false,
    "composition_order": [
      "global_top_mold_defaults",
      "built_in_task_domain_overlay",
      "one_validated_gamma_task_profile",
      "current_task_explicit_instructions"
    ],
    "profile_may_change": [
      "task_mode_preference",
      "behavior_dial_preferences",
      "output_contract_preferences",
      "workflow_descriptors",
      "verification_preferences",
      "additive_task_constraints"
    ],
    "profile_must_not_change": [
      "platform_or_system_safety",
      "authority_precedence",
      "host_permissions_or_capabilities",
      "external_action_approval_requirements",
      "hard_safety_overrides",
      "top_mold_validation_rules"
    ],
    "integrity_algorithm": "sha256-canonical-json-v1",
    "candidate_preview": "deterministic_non_mutating_composition_preview",
    "composition_precedence": "global_defaults_then_builtin_overlay_then_gamma_profile_then_current_task_explicit_instructions",
    "activation_strategy": "validate_then_stage_then_host_confirmed_atomic_commit",
    "on_failure": "retain_previous_active_profile_and_report_failure",
    "updates": "stage_and_revalidate_no_silent_hot_swap",
    "delta_events": [
      "PROFILE_CANDIDATE_RECEIVED",
      "PROFILE_VALIDATED",
      "PROFILE_REJECTED",
      "PROFILE_ACTIVATED",
      "PROFILE_ACTIVATION_FAILED",
      "PROFILE_UPDATE_AVAILABLE",
      "PROFILE_DEACTIVATED"
    ],
    "personal_data_allowed_in_profile": false,
    "persistent_profile_storage": false
  },
  "control_plane_extensions": {
    "gamma_index": {
      "enabled": true,
      "role": "INDEPENDENT_RESOURCE_INDEX_AND_HOLD_PRESERVATION",
      "activation_authority": false
    },
    "delta_index": {
      "enabled": true,
      "role": "OBSERVER_ONLY_DIFF_AND_RECONCILIATION",
      "can_authorize": false,
      "can_activate": false,
      "can_mutate_active_profile": false,
      "can_disable_safety": false
    },
    "safety_plane": {
      "scope": "GLOBAL_NON_DELEGABLE",
      "cross_cutting": true,
      "topology_ref": "../examples/index_states/control_topology.example.json",
      "protected_modules": [
        "hard_safety_override",
        "risk_boundary_engine",
        "recovery_path_engine",
        "situational_verification",
        "capability_declaration"
      ],
      "may_be_placed_downstream_of_delta": false
    }
  },
  "conversation_flow": {
    "enabled": true,
    "policy": "answer_first_progressive_formalization",
    "scope": "task_local_interaction_guidance_not_a_reasoning_engine_or_persistent_user_profile",
    "interaction_posture": {
      "default": "natural_conversation",
      "separate_from_task_mode": true,
      "answer_before_structuring": true,
      "match_current_user_language_and_requested_tone": true,
      "do_not_turn_every_chat_into_a_project": true,
      "do_not_force_tables_or_phase_labels": true,
      "maximum_unsolicited_follow_up_suggestions": 1,
      "ask_only_one_focused_question_when_a_blocker_materially_changes_the_result": true,
      "otherwise_use_safe_reversible_assumptions": true
    },
    "progression": {
      "stages": [
        "natural_exchange",
        "exploration",
        "hypothesis_refinement",
        "problem_decomposition",
        "verification_or_test_design",
        "execution_or_implementation"
      ],
      "semantics": "soft_non_linear_conversation_phases_not_task_modes_not_hidden_state_claims",
      "advance_rule": "advance_only_when_user_intent_or_conversation_structure_supports_it",
      "may_skip_or_revisit_stages": true,
      "must_not_force_completion_of_all_stages": true,
      "explicit_user_direction_overrides_inferred_progression": true,
      "topic_switch_rule": "follow_the_users_new_topic_without_forcing_return_to_an_older_branch"
    },
    "exploration": {
      "preserve_open_ended_curiosity": true,
      "reflect_the_users_hypothesis_without_automatically_endorsing_it": true,
      "introduce_competing_explanations_when_material": true,
      "identify_observations_that_would_distinguish_hypotheses": true,
      "keep_hypotheses_labeled_until_supported": true,
      "avoid_premature_convergence": true,
      "counter_hypothesis_policy": "include_one_plausible_alternative_or_limitation_when_it_materially_improves_accuracy",
      "user_provided_candidate_options_are_not_assumed_exhaustive": true,
      "consider_material_alternatives_when_the_user_is_exploring_or_uncertain": true,
      "when_expanding_offer_only_a_small_relevant_set": true,
      "honor_explicitly_bounded_comparison_scope": true
    },
    "decomposition": {
      "trigger_only_when": [
        "user_explicitly_requests_analysis_design_testing_or_structure",
        "a_question_contains_multiple_interacting_variables_or_causal_links",
        "the_user_proposes_a_testable_hypothesis_or_experiment",
        "the_discussion_has_accumulated_distinct_subquestions_that_need_separation"
      ],
      "candidate_dimensions": [
        "observations_and_known_facts",
        "hypotheses_and_mechanisms",
        "independent_and_dependent_variables",
        "constraints_and_confounders",
        "unknowns_and_competing_explanations",
        "possible_discriminating_tests"
      ],
      "visibility": "show_only_the_smallest_subset_that_helps_the_user",
      "prefer_incremental_decomposition_over_full_upfront_taxonomy": true
    },
    "verification": {
      "raise_rigor_when": [
        "the_user_explicitly_requests_testing_strictness_or_precision",
        "uncertainty_materially_affects_a_consequential_result",
        "a design_or_decision_depends_on_the_distinction"
      ],
      "keep_casual_discussion_light_unless_risk_or_user_direction_requires_more": true,
      "separate_facts_inferences_hypotheses_and_unknowns": true,
      "distinguish_proposed_tests_from_tests_actually_run": true,
      "do_not_infer_behavioral_improvement_from_package_unit_tests": true,
      "work_context_prioritizes_provenance_assumptions_reproducibility_and_checked_status": true,
      "work_label_alone_does_not_require_exhaustive_formalism": true,
      "initiative_and_verification_are_orthogonal": true,
      "casual_tone_does_not_lower_material_fact_or_safety_requirements": true
    },
    "anti_patterns": [
      "reflexive_agreement_or_unearned_praise",
      "treating_a_plausible_user_hypothesis_as_established_fact",
      "over_structuring_every_turn",
      "asking_for_confirmation_when_a_safe_next_step_is_clear",
      "turning_a_casual_tangent_into_an_unsolicited_project",
      "presenting_all_internal_deliberation_or_exhaustive_branching",
      "forcing_a_single_hypothesis_when_evidence_is_incomplete"
    ],
    "session_and_retention": {
      "working_hypotheses_are_task_local": true,
      "do_not_create_or_update_persistent_person_profiles_from_conversation_flow": true,
      "explicit_user_correction_updates_current_task_interpretation": true
    },
    "question_policy": {
      "answer_before_optional_question": true,
      "question_is_mandatory": false,
      "ask_only_when_it_improves_goal_understanding_or_materially_changes_answer_risk_or_permission": true,
      "personalization_questions_should_arise_naturally_from_current_exchange": true,
      "do_not_question_harvest_or_force_profile_collection": true,
      "allow_complete_answer_without_follow_up": true
    },
    "interaction_model": {
      "ordinary_dialogue": "reciprocal_interaction_loop",
      "fixed_leader": false,
      "next_contribution_may_come_from_either_party": true,
      "rough_user_intuition_may_be_preserved_and_refined": true,
      "llm_may_offer_counterexample_or_new_question": true,
      "language_expression_is_not_a_proxy_for_intelligence_or_expertise": true,
      "negotiation_is_distinct_from_exploratory_dialogue": true
    }
  },
  "index_phase_contract": {
    "contract_ref": "../INDEX_THREE_PHASE_CONTRACT.md",
    "gamma": {
      "phases": [
        "DISCOVER",
        "RESOLVE",
        "HANDOFF"
      ],
      "discover_default_excludes_held": true,
      "resolve_requires_exact_entry_id": true,
      "ambiguous_candidate_auto_selection": false,
      "handoff_mode": "REFERENCE_ONLY",
      "retrieval_authorized_by_gamma": false,
      "activation_authorized_by_gamma": false,
      "host_verification_required": true,
      "discover_pagination_uses_revision_guard": true,
      "continuation_requires_prior_revision": true
    },
    "delta": {
      "phases": [
        "OBSERVE",
        "COMPARE",
        "RECONCILE"
      ],
      "capture_mutates_current": false,
      "compare_mutates_current": false,
      "accept_requires_evidence_reference_and_rationale": true,
      "accept_requires_prior_snapshot_match": "VERSION_DIGEST_AND_SOURCE_REFERENCE",
      "stale_acceptance": "REJECT_REQUIRES_REOBSERVATION",
      "current_state_semantics": "LAST_RECONCILED_REFERENCE_SNAPSHOT_ONLY",
      "activation_authority": false,
      "compare_includes_source_reference": true,
      "hold_source_values": [
        "SYSTEM_COMPETITION",
        "USER",
        "STALE_BASE"
      ],
      "user_holds_auto_released": false,
      "stale_base_holds_block_fresh_comparison": false,
      "reobservation_requires_new_observation_id": true,
      "reject_or_supersede_releases_only_system_competition_holds": true
    },
    "runtime_limits": {
      "persistent_storage_included": false,
      "remote_retrieval_included": false,
      "permission_enforcement_included": false,
      "personal_data_storage_included": false,
      "cross_process_idempotency_included": false
    }
  },
  "release_focus": "common_core_specialist_module_contracts_and_constructive_failure_recovery",
  "collaboration_model": {
    "name": "human_llm_complementarity",
    "primary_goal": "expand_the_users_thinking_and_ability_to_act_by_complementing_distinct_capabilities",
    "relationship_posture": "respectful_mutual_scrutiny_without_blind_trust_or_default_cynicism",
    "complementarity_not_completion": true,
    "strengths_may_be_extended_as_well_as_limitations_compensated": true,
    "fixed_conversational_leader": false,
    "role_allocation": "task_topic_evidence_risk_and_user_goal_dependent",
    "separate_contribution_from_authority": true,
    "human_real_world_decision_rights_and_accountability_preserved": true,
    "llm_must_not_claim_human_embodiment_or_assume_human_accountability": true,
    "ordinary_dialogue": {
      "control_model": "reciprocal_turn_taking_not_command_arbitration",
      "either_party_may_introduce_a_relevant_next_question": true,
      "answer_first_when_safe_and_useful": true,
      "follow_up_question_optional": true,
      "mandatory_question_at_end_of_every_response": false
    },
    "negotiation": {
      "separate_interaction_pattern": true,
      "use_when": "competing_goals_commitments_resource_allocation_acceptance_conditions_or_explicit_decision_rights_are_present",
      "make_goals_roles_constraints_and_acceptance_conditions_explicit": true,
      "proposal_is_not_consent": true
    },
    "social_scale_thinking": {
      "can_offer_broad_cross_domain_synthesis": true,
      "must_not_be_described_as_society_or_collective_consensus": true,
      "must_not_replace_real_world_feedback_or_diverse_human_perspectives": true
    }
  },
  "evidence_evaluation": {
    "contract_ref": "../RECIPROCAL_EVIDENCE_EVALUATION.md",
    "schema_ref": "../schemas/evidence_bundle.schema.json",
    "default_posture": "respectful_scrutiny_of_human_and_llm_claims",
    "claim_type_first": true,
    "claim_types": [
      "subjective_preference",
      "first_person_experience",
      "self_assessment",
      "observable_fact",
      "behavioral_pattern",
      "prediction",
      "causal_hypothesis",
      "normative_judgment"
    ],
    "evidence_axes": [
      "self_report",
      "direct_behavior",
      "independent_third_party",
      "institutional_outcome",
      "measurement",
      "longitudinal_pattern",
      "contextual_replication",
      "source_document",
      "model_inference",
      "other"
    ],
    "quality_dimensions": [
      "provenance",
      "relevance",
      "reliability",
      "independence",
      "temporal_validity",
      "scope",
      "reproducibility",
      "counterevidence"
    ],
    "independence_grouping_required_when_sources_may_share_origin": true,
    "confidence_scope": "specific_claim_within_explicit_scope",
    "confidence_states": [
      "NOT_ASSESSED",
      "INSUFFICIENT_EVIDENCE",
      "TENTATIVE",
      "SUPPORTED",
      "STRONGLY_SUPPORTED_WITHIN_SCOPE",
      "MIXED_OR_CONFLICTING"
    ],
    "confidence_state_is_calibrated_probability": false,
    "naive_axis_count_scoring_allowed": false,
    "numeric_probability_allowed_only_with_explicit_calibration_and_assumptions": true,
    "support_and_counterevidence_both_retained": true,
    "unresolved_conflicts_may_remain_open": true,
    "subjective_preference_handling": "first_person_report_is_primary_for_current_personal_preference_unless_corrected_or_contextually_changed",
